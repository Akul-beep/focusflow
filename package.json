{
  "name": "flowly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "dev:unlock": "rm -rf .next/dev",
    "dev:clean": "rm -rf .next && next dev --webpack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:schedule": "npx --yes tsx scripts/scheduling-e2e.ts",
    "test:syllabus": "npx --yes tsx scripts/syllabus-myp5-e2e.ts",
    "test:qa": "npx --yes tsx scripts/qa-checklist-e2e.ts",
    "test:all": "npm run test:schedule && npm run test:syllabus && npm run test:qa",
    "test:smoke-backend-ai": "npx --yes tsx scripts/smoke-backend-ai.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@schedule-x/calendar": "^4.3.1",
    "@schedule-x/event-modal": "^4.3.1",
    "@schedule-x/events-service": "^4.3.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.3.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.93.2",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/extension-task-item": "^3.20.4",
    "@tiptap/extension-task-list": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "next": "16.1.1",
    "pdfjs-dist": "^5.5.207",
    "posthog-js": "^1.364.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "temporal-polyfill": "^0.3.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
